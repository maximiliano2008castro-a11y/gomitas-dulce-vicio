# Copia este archivo como .env y cambia SECRET_KEY.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-llave-aleatoria-de-64-caracteres-hex
ACCESS_TOKEN_EXPIRE_MINUTES=30
# El personal (admin y trabajadores) deja el backoffice abierto todo el turno: sesion de 12 horas.
STAFF_TOKEN_EXPIRE_MINUTES=720

# Por defecto usa SQLite en back/gomitas.db (sin instalar nada). Para MySQL/MariaDB con db.sql:
#   pip install pymysql
#   DATABASE_URL=mysql+pymysql://root:password@localhost/gomitas_ecommerce

CORS_ORIGINS=["http://localhost:5173"]

# Usuarios de prueba que se crean al arrancar si no existen
SEED_ADMIN_EMAIL=admin@gomitas.com
SEED_ADMIN_PASSWORD=admin12345
SEED_CLIENTE_EMAIL=cliente@prueba.com
SEED_CLIENTE_PASSWORD=cliente12345
SEED_TRABAJADOR_EMAIL=trabajador@gomitas.com
SEED_TRABAJADOR_PASSWORD=trabajador12345
SEED_PEDIDOS_DEMO=true

# ---- Mercado Pago (Checkout Pro) ----
# Vacio = pasarela SIMULADA (no necesitas cuenta). Para usar Mercado Pago de verdad,
# pega aqui el Access Token de prueba de tu aplicacion:
#   https://www.mercadopago.com.mx/developers/panel/app -> tu app -> Credenciales de prueba
MP_ACCESS_TOKEN=
# Opcional: solo si MP puede alcanzar tu backend (ngrok o un servidor publico).
MP_NOTIFICATION_URL=
MP_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173

# ---- Imagenes subidas desde el backoffice ----
# Carpeta donde se guardan (se sirven en http://localhost:8000/uploads/...). Por defecto back/uploads.
# UPLOADS_DIR=
